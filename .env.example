# Copy to .env next to docker-compose.yml and fill in. Both values are required
# by docker-compose.yml, which refuses to start without them.

# Master key. Seals every project's secrets, the SSO client secret, per-project
# git tokens, the external secret store's token and notification webhook URLs.
#
#   openssl rand -base64 32
#
# Losing it means losing every stored secret; changing it means re-sealing what
# is already stored with `arcloom rekey -old <current> -new <next>` while the
# server is stopped. The server refuses to boot on a key shorter than 12
# characters, or on the placeholder that used to ship in docker-compose.yml.
ARCLOOM_SECRET_KEY=

# Password for the first admin account. Used on the FIRST RUN ONLY — once any
# user exists it is ignored, so changing it later does not reset anything (use
# the Users tab in Settings, or the password-reset endpoint).
ARCLOOM_ADMIN_PASSWORD=
